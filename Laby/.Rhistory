# Initialize variables
x <- 0
# Execute the loop while x is less than 10
while(x > 10) {
cat('x is currently:', x, '\n')
print('x is still less than 10, adding 1 to x')
# Increment x by 1
x <- x + 1
}
# Initialize variables
x <- 0
# Execute the loop while x is less than 10
while(x < 10) {
cat('x is currently:', x, '\n')
print('x is still less than 10, adding 1 to x')
# Increment x by 1
x <- x + 1
# Check if x has reached 10
if(x == 10) {
print("x is equal to 10! Terminating loop")
}
}
