# Vector to iterate over
x <- c(1, 2, 3, 4, 5, 6, 7, 8)
# Iterate over each element in the vector
for(i in x) {
# Skip odd numbers
if(i %% 2 != 0) {
next
}
# Print even numbers
print(i)
}
