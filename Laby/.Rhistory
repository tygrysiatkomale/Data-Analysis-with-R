sum <- 0
number <- as.numeric(readline(prompt = "Give a number: "))
while (number >= 0) {
sum <- sum + number
number <- as.numeric(readline(prompt = "Give a number: "))
}
cat("Sum of all entered numbers (excluding negative):", sum, "\n")
