knitr::opts_chunk$set(echo = TRUE, message = FALSE, warning = FALSE)
devtools_needed <- c("tidyverse", "skimr", "visdat", "corrplot", "patchwork", "ggrepel")
for(p in devtools_needed) if(!requireNamespace(p, quietly = TRUE)) install.packages(p)
library(tidyverse)
library(skimr)
library(visdat)
library(corrplot)
library(patchwork)
library(ggrepel)
df <- read_csv("richmondway.csv")
dim(df)                 # rows × cols
glimpse(df)             # structure
skim(df)                # quick stats
vis_miss(df, cluster = TRUE) +
labs(title = "Missing-Value Patterns in RichmondWay")
df <- df %>%
mutate(
Season        = as.integer(Season),
Episode       = as.integer(Episode),
F_score       = as.numeric(F_score),
F_perc        = as.numeric(F_perc),
Imdb_rating   = as.numeric(Imdb_rating),
Episode_order = as.integer(Episode_order),
year          = 2020 + Season               # pseudo-calendar year
)
# duplicate check
stopifnot(sum(duplicated(df)) == 0)
df <- df %>%
group_by(Season) %>%
mutate(
f_perc_rank       = percent_rank(F_perc),
season_avg_f      = mean(F_score, na.rm = TRUE),
above_season_avg  = F_score > season_avg_f,
rating_z          = as.numeric(scale(Imdb_rating)),
f_perc_z          = as.numeric(scale(F_perc)),
is_finale         = Episode == max(Episode),
flag_count        = rowSums(across(ends_with("_flag"))),
season_episode_id = str_glue("S{Season}E{str_pad(Episode, 2, pad='0')}") ,
curse_density     = ifelse(!is.na(Episode_length), F_score / Episode_length, NA_real_),
episode_id        = row_number()
) %>%
ungroup()
descr_tbl <- df %>%
summarise(across(where(is.numeric), list(
N      = ~sum(!is.na(.x)),
mean   = ~mean(.x, na.rm = TRUE),
sd     = ~sd(.x,  na.rm = TRUE),
median = ~median(.x, na.rm = TRUE),
min    = ~min(.x, na.rm = TRUE),
max    = ~max(.x, na.rm = TRUE)
), .names = "{.col}_{.fn}"))
knitr::kable(t(descr_tbl), col.names = "value", caption = "Summary statistics for numeric variables")
